{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bosshunt_target_v2.schema.json",
  "title": "BossHuntTargetV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "company", "company_domain", "role_title", "intake_mode", "job_url", "jd_source", "posting_status", "geography", "function", "explicit_boss_titles", "reporting_hypotheses", "authority_sources", "owner_scope", "capabilities"],
  "properties": {
    "schema_version": {"const": "BossHuntTargetV2"},
    "target_id": {"type": "string", "minLength": 1},
    "source_tracker_id": {"type": ["string", "null"]},
    "company": {"type": "string", "minLength": 1},
    "company_domain": {"type": ["string", "null"]},
    "role_title": {"type": "string", "minLength": 1},
    "intake_mode": {"enum": ["LIVE_REQUISITION", "POST_APPLICATION", "PROACTIVE_COMPANY"]},
    "job_url": {"type": ["string", "null"]},
    "jd_source": {"type": ["string", "null"]},
    "posting_status": {"enum": ["OPEN", "CLOSED", "UNKNOWN", "NOT_APPLICABLE"]},
    "geography": {"type": ["string", "null"]},
    "function": {"type": ["string", "null"]},
    "explicit_boss_titles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reporting_hypotheses": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/hypothesis"}},
    "authority_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}},
    "owner_scope": {"type": "string", "minLength": 1},
    "capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "$defs": {
    "hypothesis": {"type": "object", "additionalProperties": false, "required": ["title", "basis", "would_support", "would_refute"], "properties": {"title": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}, "would_support": {"type": "string", "minLength": 1}, "would_refute": {"type": "string", "minLength": 1}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authority_type", "source_ref", "observed_at", "authority_scope", "evidence_sha256"], "properties": {"authority_type": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "authority_scope": {"type": "string", "minLength": 1}, "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "capabilityReceipt": {"type": "object", "additionalProperties": false, "required": ["state", "observed_at", "scope", "receipt_ref", "evidence_sha256"], "properties": {"state": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNAUTHENTICATED", "WRONG_SCOPE", "BLOCKED", "NOT_APPLICABLE"]}, "observed_at": {"type": "string", "format": "date-time"}, "scope": {"type": "string", "minLength": 1}, "receipt_ref": {"type": "string", "minLength": 1}, "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["local_role_authority", "public_web", "authenticated_profile", "hunter_account_details", "hunter_email_finder", "hunter_domain_search", "local_python", "schema_validation"], "properties": {"local_role_authority": {"$ref": "#/$defs/capabilityReceipt"}, "public_web": {"$ref": "#/$defs/capabilityReceipt"}, "authenticated_profile": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_account_details": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_email_finder": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_domain_search": {"$ref": "#/$defs/capabilityReceipt"}, "local_python": {"$ref": "#/$defs/capabilityReceipt"}, "schema_validation": {"$ref": "#/$defs/capabilityReceipt"}}}
  }
}
