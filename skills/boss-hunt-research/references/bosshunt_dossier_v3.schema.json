{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bosshunt_dossier_v3.schema.json",
  "title": "BossHuntResearchDossierV3",
  "description": "Fail-closed Boss Hunt research dossier. V2 remains preserved and is not reinterpreted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "researcher_id", "role", "capabilities", "guards", "search", "recipient", "hook", "hook_search", "candidate_proof", "channel", "decision", "disconfirmers", "quality_review", "query_access_limitations", "owner_summary"],
  "properties": {
    "schema_version": {"const": "BossHuntResearchDossierV3"},
    "run_id": {"type": "string", "minLength": 1},
    "researcher_id": {"type": "string", "minLength": 1},
    "role": {"$ref": "#/$defs/role"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "guards": {"$ref": "#/$defs/guards"},
    "search": {"$ref": "#/$defs/search"},
    "recipient": {"$ref": "#/$defs/recipient"},
    "hook": {"$ref": "#/$defs/hook"},
    "hook_search": {"$ref": "#/$defs/hookSearch"},
    "candidate_proof": {"$ref": "#/$defs/candidateProof"},
    "channel": {"$ref": "#/$defs/channel"},
    "decision": {"$ref": "#/$defs/decision"},
    "disconfirmers": {"type": "array", "items": {"$ref": "#/$defs/disconfirmer"}},
    "quality_review": {"$ref": "#/$defs/qualityReview"},
    "query_access_limitations": {"type": "array", "items": {"$ref": "#/$defs/accessLimitation"}},
    "owner_summary": {"$ref": "#/$defs/ownerSummary"},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hypothesis": {"type": "object", "additionalProperties": false, "required": ["title", "basis", "would_support", "would_refute"], "properties": {"title": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}, "would_support": {"type": "string", "minLength": 1}, "would_refute": {"type": "string", "minLength": 1}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authority_type", "source_ref", "observed_at", "authority_scope", "evidence_sha256"], "properties": {"authority_type": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "authority_scope": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha"}}},
    "role": {"type": "object", "additionalProperties": false, "required": ["target_id", "source_tracker_id", "intake_mode", "company", "company_domain", "role_title", "job_url", "jd_source", "posting_status", "geography", "function", "explicit_boss_titles", "authority_sources", "owner_scope"], "properties": {"target_id": {"type": "string", "minLength": 1}, "source_tracker_id": {"type": ["string", "null"]}, "intake_mode": {"enum": ["LIVE_REQUISITION", "POST_APPLICATION", "PROACTIVE_COMPANY"]}, "company": {"type": "string", "minLength": 1}, "company_domain": {"type": ["string", "null"]}, "role_title": {"type": "string", "minLength": 1}, "job_url": {"type": ["string", "null"]}, "jd_source": {"type": ["string", "null"]}, "posting_status": {"enum": ["OPEN", "CLOSED", "UNKNOWN", "NOT_APPLICABLE"]}, "geography": {"type": ["string", "null"]}, "function": {"type": ["string", "null"]}, "explicit_boss_titles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "authority_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}}, "owner_scope": {"type": "string", "minLength": 1}}},
    "capabilityReceipt": {"type": "object", "additionalProperties": false, "required": ["state", "observed_at", "scope", "receipt_ref", "evidence_sha256"], "properties": {"state": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNAUTHENTICATED", "WRONG_SCOPE", "BLOCKED", "NOT_APPLICABLE"]}, "observed_at": {"type": "string", "format": "date-time"}, "scope": {"type": "string", "minLength": 1}, "receipt_ref": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["local_role_authority", "public_web", "authenticated_profile", "hunter_account_details", "hunter_email_finder", "hunter_domain_search", "local_python", "schema_validation"], "properties": {"local_role_authority": {"$ref": "#/$defs/capabilityReceipt"}, "public_web": {"$ref": "#/$defs/capabilityReceipt"}, "authenticated_profile": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_account_details": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_email_finder": {"$ref": "#/$defs/capabilityReceipt"}, "hunter_domain_search": {"$ref": "#/$defs/capabilityReceipt"}, "local_python": {"$ref": "#/$defs/capabilityReceipt"}, "schema_validation": {"$ref": "#/$defs/capabilityReceipt"}}},
    "guardReceipt": {"type": "object", "additionalProperties": false, "required": ["guard", "result", "source_ref", "observed_at", "authority_scope", "evidence_sha256", "run_id"], "properties": {"guard": {"enum": ["NO_BYPASS", "TERMINAL_OUTREACH", "OWNER_CLOSED", "COMPANY_COLLISION", "DISCONFIRMATION"]}, "result": {"enum": ["CLEAR", "TRIGGERED", "UNKNOWN", "CONSOLIDATED"]}, "source_ref": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "authority_scope": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 1}}},
    "guards": {"type": "object", "additionalProperties": false, "required": ["overall_state", "receipts"], "properties": {"overall_state": {"enum": ["CLEAR", "CONSOLIDATED", "SEQUENCED", "CONFLICT", "AMBIGUOUS_DUPLICATE", "BLOCKED", "UNKNOWN"]}, "receipts": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/guardReceipt"}}}},
    "queryTrace": {"type": "object", "additionalProperties": false, "required": ["stage", "surface", "query", "observed_at", "outcome", "result_url", "run_id"], "properties": {"stage": {"enum": ["EMPLOYER_CONTEXT", "LITERAL_SEAT", "REPORTING_ALTERNATIVES", "REQUISITION_AND_SEARCH_OWNER", "ADJACENT_ROUTES", "AUTHENTICATED_CURRENTNESS", "HOOK_ARTIFACT", "EMAIL_DISCOVERY_FIRST_PARTY", "HUNTER_DISCOVERY"]}, "surface": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "outcome": {"enum": ["HIT", "MISS", "BLOCKED", "NOT_APPLICABLE"]}, "result_url": {"type": ["string", "null"]}, "run_id": {"type": "string", "minLength": 1}, "note": {"type": ["string", "null"]}}},
    "identityBinding": {"type": "object", "additionalProperties": false, "required": ["recipient_name", "profile_url", "company", "target_id"], "properties": {"recipient_name": {"type": "string", "minLength": 1}, "profile_url": {"type": "string", "minLength": 1}, "company": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}}},
    "authCurrentness": {"type": "object", "additionalProperties": false, "required": ["capability_receipt_ref", "surface", "identity_binding", "observed_at", "fresh_until", "result", "evidence_ref", "evidence_sha256", "run_id"], "properties": {"capability_receipt_ref": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "identity_binding": {"$ref": "#/$defs/identityBinding"}, "observed_at": {"type": "string", "format": "date-time"}, "fresh_until": {"type": "string", "format": "date-time"}, "result": {"enum": ["CONFIRMED", "MISMATCH", "UNAVAILABLE", "UNAUTHENTICATED", "WRONG_SCOPE", "BLOCKED", "NOT_APPLICABLE"]}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 1}}},
    "search": {"type": "object", "additionalProperties": false, "required": ["reporting_hypotheses", "literal_seat_result", "queries_run", "authenticated_currentness"], "properties": {"reporting_hypotheses": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/hypothesis"}}, "literal_seat_result": {"enum": ["HIT", "MISS", "BLOCKED"]}, "queries_run": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/queryTrace"}}, "authenticated_currentness": {"$ref": "#/$defs/authCurrentness"}}},
    "currentnessSource": {"type": "object", "additionalProperties": false, "required": ["url", "observed_at", "run_id", "supports", "source_family", "independence_key", "content_sha256"], "properties": {"url": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "run_id": {"type": "string", "minLength": 1}, "supports": {"enum": ["CURRENT_TITLE_AND_EMPLOYER", "PARTIAL", "NOT_SUPPORTED", "UNREADABLE"]}, "source_family": {"enum": ["AUTHENTICATED_PROFILE", "EMPLOYER", "RECIPIENT_ARTIFACT", "INDEPENDENT_DURABLE", "AGGREGATOR"]}, "independence_key": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha"}}},
    "recipient": {"type": "object", "additionalProperties": false, "required": ["name", "current_title", "route_class", "requisition_linkage", "profile_url", "currentness_sources"], "properties": {"name": {"type": ["string", "null"]}, "current_title": {"type": ["string", "null"]}, "route_class": {"enum": ["CONFIRMED_HM", "LIKELY_HM", "RECRUITER_JOB_POSTER", "RECRUITER_OWNER_CHECK", "SPONSOR_AUTHORITY", "POTENTIAL_COWORKER", "WARM_CONNECTOR", "APEX_CONTEXT", "NOT_PUBLIC", "NO_SAFE_ROUTE", "DISCONFIRMED", "UNRESOLVED"]}, "requisition_linkage": {"enum": ["EXPLICIT", "ADJACENT", "INFERRED", "NONE"]}, "profile_url": {"type": ["string", "null"]}, "currentness_sources": {"type": "array", "items": {"$ref": "#/$defs/currentnessSource"}}}},
    "evidenceBinding": {"type": "object", "additionalProperties": false, "required": ["intent_id", "result_url", "content_sha256", "run_id"], "properties": {"intent_id": {"type": "string", "minLength": 1}, "result_url": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha"}, "run_id": {"type": "string", "minLength": 1}}},
    "hook": {"type": "object", "additionalProperties": false, "required": ["text", "attribution", "artifact_url", "artifact_date", "observed_at", "support_excerpt", "support_state", "run_id", "evidence_binding"], "properties": {"text": {"type": ["string", "null"]}, "attribution": {"enum": ["PERSON", "COMPANY", "JD", "NONE"]}, "artifact_url": {"type": ["string", "null"]}, "artifact_date": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}, "support_excerpt": {"type": ["string", "null"]}, "support_state": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNREADABLE", "ABSENT"]}, "run_id": {"type": "string", "minLength": 1}, "evidence_binding": {"type": ["object", "null"], "oneOf": [{"$ref": "#/$defs/evidenceBinding"}, {"type": "null"}]}}},
    "intentSignature": {"type": "object", "additionalProperties": false, "required": ["subject", "claim", "surface_family"], "properties": {"subject": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "surface_family": {"type": "string", "minLength": 1}}},
    "hookIntent": {"type": "object", "additionalProperties": false, "required": ["intent_id", "family", "signature", "canonical_fingerprint", "hypothesis", "surface", "query_or_action", "observed_at", "run_id", "outcome", "result_url", "content_sha256", "supports_selected_hook"], "properties": {"intent_id": {"type": "string", "minLength": 1}, "family": {"enum": ["RECIPIENT_AUTHORED", "RECIPIENT_SPEAKING", "EMPLOYER_PERSON_ATTRIBUTION", "COMPANY_MANDATE", "JD_CONTEXT", "ATTRIBUTION_REFUTATION"]}, "signature": {"$ref": "#/$defs/intentSignature"}, "canonical_fingerprint": {"$ref": "#/$defs/sha"}, "hypothesis": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "query_or_action": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "run_id": {"type": "string", "minLength": 1}, "outcome": {"enum": ["HIT", "MISS", "BLOCKED", "NOT_APPLICABLE"]}, "result_url": {"type": ["string", "null"]}, "content_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "supports_selected_hook": {"type": "boolean"}}},
    "hookSearch": {"type": "object", "additionalProperties": false, "required": ["policy_version", "intents", "fallback_kind", "coverage_claim"], "properties": {"policy_version": {"const": "BossHuntHookSearchV2"}, "intents": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hookIntent"}}, "fallback_kind": {"enum": ["RECIPIENT_SPECIFIC", "GENERIC_COMPANY", "GENERIC_JD", "NONE"]}, "coverage_claim": {"enum": ["COMPLETE", "INCOMPLETE"]}}},
    "candidateProof": {"type": "object", "additionalProperties": false, "required": ["claim", "source_ref", "source_kind", "evidence_sha256", "run_id", "support_state"], "properties": {"claim": {"type": ["string", "null"], "minLength": 1}, "source_ref": {"type": ["string", "null"], "minLength": 1}, "source_kind": {"enum": ["APPROVED_CV", "PORTFOLIO", "OWNER_SUPPLIED", null]}, "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "run_id": {"type": "string", "minLength": 1}, "support_state": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNREADABLE", "NOT_EVALUATED"]}, "not_evaluated_reason": {"type": ["string", "null"], "minLength": 1}}},
    "hunterUsage": {"type": "object", "additionalProperties": false, "required": ["account_snapshot_at", "account_receipt_ref", "method", "result", "domain_search_limit", "discovery_connector_calls", "search_credits_used", "verification_credits_used"], "properties": {"account_snapshot_at": {"type": ["string", "null"]}, "account_receipt_ref": {"type": ["string", "null"]}, "method": {"enum": ["EMAIL_FINDER", "DOMAIN_SEARCH", "NONE"]}, "result": {"enum": ["HIT", "MISS", "BLOCKED", "NOT_USED"]}, "domain_search_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 10}, "discovery_connector_calls": {"type": "integer", "minimum": 0, "maximum": 1}, "search_credits_used": {"type": "integer", "minimum": 0, "maximum": 1}, "verification_credits_used": {"type": "integer", "minimum": 0, "maximum": 0}}},
    "channel": {"type": "object", "additionalProperties": false, "required": ["kind", "address", "state", "basis", "source_url", "hunter_usage"], "properties": {"kind": {"enum": ["EMAIL", "PROFESSIONAL_PLATFORM", "RECRUITER_ROUTE", "NONE"]}, "address": {"type": ["string", "null"]}, "state": {"enum": ["VERIFIED", "VERIFY_CHANNEL", "UNKNOWN", "UNAVAILABLE"]}, "basis": {"enum": ["PUBLISHED_FIRST_PARTY", "PATTERN_CONCRETE_COLLEAGUE", "HUNTER_EMAIL_FINDER", "HUNTER_DOMAIN_SEARCH", "PROFESSIONAL_PLATFORM", "RECRUITER_ROUTE", "NONE"]}, "source_url": {"type": ["string", "null"]}, "hunter_usage": {"$ref": "#/$defs/hunterUsage"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["readiness", "permitted_response", "requires_owner_decision", "reason", "next_bounded_search"], "properties": {"readiness": {"enum": ["DRAFT_READY_VERIFY_CHANNEL", "OWNER_DECISION", "PROFILE_CHECK", "BLOCKED", "RESEARCH_MORE"]}, "permitted_response": {"enum": ["CONVERSATION", "ROUTE", "RECRUITER_ASSESSMENT", "PROCESS_CLARIFICATION", "INFORMATIONAL_GUIDANCE", "NONE"]}, "requires_owner_decision": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}, "next_bounded_search": {"type": ["string", "null"]}}},
    "reviewCheck": {"type": "object", "additionalProperties": false, "required": ["name", "verdict", "evidence_refs"], "properties": {"name": {"enum": ["RESOURCE_COVERAGE", "ROUTE_HONESTY", "CURRENT_ROLE", "HOOK_ATTRIBUTION", "CHANNEL_SEPARATION", "COLLISION_LIFECYCLE"]}, "verdict": {"enum": ["PASS", "FAIL", "PENDING"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "qualityReview": {"type": "object", "additionalProperties": false, "required": ["review_schema", "reviewer_id", "review_subject_sha256", "verdict", "checks", "reviewed_at"], "properties": {"review_schema": {"const": "BossHuntIndependentReviewV2"}, "reviewer_id": {"type": "string", "minLength": 1}, "review_subject_sha256": {"$ref": "#/$defs/sha"}, "verdict": {"enum": ["PASS", "FAIL", "PENDING"]}, "checks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/reviewCheck"}}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}, "note": {"type": ["string", "null"]}}},
    "disconfirmer": {"type": "object", "additionalProperties": false, "required": ["subject", "finding", "observed_at", "source_urls", "supersedes"], "properties": {"subject": {"type": "string", "minLength": 1}, "finding": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "source_urls": {"type": "array", "items": {"type": "string", "minLength": 1}}, "supersedes": {"type": ["string", "null"]}}},
    "accessLimitation": {"type": "object", "additionalProperties": false, "required": ["capability", "surface", "state", "reason", "observed_at", "receipt_ref"], "properties": {"capability": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "state": {"enum": ["UNAVAILABLE", "UNAUTHENTICATED", "WRONG_SCOPE", "BLOCKED", "NOT_APPLICABLE"]}, "reason": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "receipt_ref": {"type": "string", "minLength": 1}}},
    "ownerSummary": {"type": "object", "additionalProperties": false, "required": ["route_summary", "weakest_assumption", "capability_limits", "next_action_or_stop", "authority_note"], "properties": {"route_summary": {"type": "string", "minLength": 1}, "weakest_assumption": {"type": "string", "minLength": 1}, "capability_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}, "next_action_or_stop": {"type": "string", "minLength": 1}, "authority_note": {"type": "string", "minLength": 1}}}
  }
}
